@model MvcMovie.Models.MovieGenreViewModel

@{
    ViewData["Title"] = "My Movies";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title mb-0">My Movies</h1>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle"></i> Create New Movie
    </a>
</div>

<div class="card search-card shadow-sm mb-4">
    <div class="card-body">
        <form asp-controller="Movies" asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-3 col-sm-6">
                <label asp-for="MovieGenre" class="form-label fw-bold">Genre</label>
                <select asp-for="MovieGenre" asp-items="Model.Genres" class="form-select">
                    <option value="">All Genres</option>
                </select>
            </div>

            <div class="col-md-3 col-sm-6">
                <label asp-for="MovieYear" class="form-label fw-bold">Year (or Newer)</label>
                <select asp-for="MovieYear" asp-items="Model.Years" class="form-select">
                    <option value="">All Years</option>
                </select>
            </div>

            <div class="col-md-4 col-sm-8">
                <label asp-for="SearchString" class="form-label fw-bold">Title</label>
                <input type="text" asp-for="SearchString" class="form-control" placeholder="Search by title..." />
            </div>

            <div class="col-md-2 col-sm-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset filters">Reset</a>
            </div>
        </form>
    </div>
</div>

@if (Model.Movies == null || !Model.Movies.Any())
{
    <div class="alert alert-info" role="alert">
        No movies found matching your search criteria.
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Movies![0].Title)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Movies![0].ReleaseDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Movies![0].Genre)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Movies![0].Price)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Movies![0].Rating)
                    </th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Movies!)
                {
                    <tr>
                        <td class="fw-semibold">
                            @Html.DisplayFor(modelItem => item.Title)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ReleaseDate)
                        </td>
                        <td>
                            <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.Genre)</span>
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Price)
                        </td>
                        <td>
                            <span class="badge bg-info text-dark">@Html.DisplayFor(modelItem => item.Rating)</span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
